# The canonical origin. Set this in Vercel to https://bidyoursite.com once the
# domain is attached. Preview deploys fall back to their own VERCEL_URL, and
# local dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://bidyoursite.com

# A POOLED Postgres connection string (Neon pooled endpoint, or Supabase
# pgbouncer). Free tiers on both are enough to run this.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Long random string. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me

# Shared secret for the auction-closing cron. Vercel sends it as a Bearer token.
CRON_SECRET=change-me
