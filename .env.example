# Local dev with the docker Postgres from the README:
DATABASE_URL=postgres://postgres:bys@127.0.0.1:55432/bidyoursite

# Production: a POOLED connection string from Neon or Supabase.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Long random string. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=change-me

# Shared secret for the auction-closing cron. Vercel sends it as a Bearer token.
CRON_SECRET=change-me
